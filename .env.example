# =========================================================
# KKS-Forge 設定値
# このファイルを `.env` にコピーし、各サイトに合わせて編集してください。
# scripts/*.sh は `.env` を読み込んで動きます。
# =========================================================

# 公開ドメイン（FQDN）。Nginx の server_name と certbot の対象になります。
FORGE_DOMAIN=forge.kkshd.jp

# CloudCLI を実行する OS ユーザー（自動で作成されます）。
FORGE_USER=forge

# CloudCLI 用ホームディレクトリ。`useradd -m` で作成されます。
FORGE_HOME=/home/forge

# CloudCLI が listen するポート。127.0.0.1 にだけバインドします。
FORGE_PORT=3300

# CloudCLI npm パッケージ名（`npx` で都度取得）。
FORGE_CLOUDCLI_PKG=@cloudcli-ai/cloudcli

# Basic 認証ユーザー名（パスワードは setup 時に対話入力）。
FORGE_BASIC_AUTH_USER=momotaka

# 許可 IP（カンマ区切り）。空のまま全許可にする場合は ALLOW_ALL=1 を併用。
FORGE_ALLOW_IPS=
FORGE_ALLOW_ALL=0

# Let's Encrypt 申請時の連絡先メール。
FORGE_LE_EMAIL=admin@kkshd.jp

# ログ出力先（systemd journal に加えてファイル出力したい場合）。
FORGE_LOG_DIR=/var/log/kks-forge

# MCP memory-service データディレクトリ。
FORGE_MEMORY_DATA_DIR=/var/lib/kks-forge/memory

# MCP memory-service Docker イメージ。
FORGE_MEMORY_IMAGE=doobidoo/mcp-memory-service:latest

# Telegram 通知ブリッジ（任意）。空なら無効。
# Bot を作って取得した token と、通知先 chat_id を入れる。
FORGE_TELEGRAM_BOT_TOKEN=
FORGE_TELEGRAM_CHAT_ID=
