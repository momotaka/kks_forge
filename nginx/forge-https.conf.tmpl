# KKS-Forge リバースプロキシ設定
# - SSL 終端
# - Basic 認証（/etc/nginx/.htpasswd-forge）
# - 許可 IP 制限（scripts/04-install-nginx.sh が「include」用ファイルを生成）
# - WebSocket 透過（CloudCLI はターミナル/チャットで WS を使う）

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${FORGE_DOMAIN};

    # ACME チャレンジ用パスだけ素通し、それ以外は HTTPS にリダイレクト
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${FORGE_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${FORGE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${FORGE_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # IP 制限（scripts/04 が空ファイル or allow リストを生成）
    include /etc/nginx/snippets/kks-forge-allow.conf;

    # Basic 認証
    auth_basic "KKS-Forge";
    auth_basic_user_file /etc/nginx/.htpasswd-forge;

    # アップロード／長時間レスポンスを許容
    client_max_body_size 50m;
    proxy_read_timeout   86400;
    proxy_send_timeout   86400;
    send_timeout         86400;

    access_log ${FORGE_LOG_DIR}/nginx-access.log;
    error_log  ${FORGE_LOG_DIR}/nginx-error.log warn;

    location / {
        proxy_pass http://127.0.0.1:${FORGE_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }
}
